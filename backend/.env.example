# ── Backend Environment Variables ────────────────────────────────────────────
# Copy this file to .env and fill in real values.

# Google Gemini API key (for the RAG + generative AI features)
GEMINI_API_KEY=your_gemini_api_key_here

# Database connection string (TimescaleDB / PostgreSQL for production)
DATABASE_URL=postgresql://user:password@localhost:5432/spotsight

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000
